# 复制为 .env 后填真实值；.env 不要提交到 git
# 只有你真要用的那几家需要填，没填的 provider 会自动跳过

# 1) 腾讯云 ASR
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 2) 阿里云 ISI（智能语音交互）—— 与百炼、听悟是三条独立产品线
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_ISI_APPKEY=

# 3) 阿里云百炼（DashScope）
DASHSCOPE_API_KEY=

# 4) 通义听悟（实验性，默认 enabled: false）
TINGWU_APP_KEY=

# 5) 讯飞开放平台（语音转写控制台里的 AppID / SecretKey）
IFLYTEK_APP_ID=
IFLYTEK_SECRET_KEY=

# 6) 火山引擎豆包语音
VOLC_APPID=
VOLC_TOKEN=
VOLC_CLUSTER=

# 7) 网易见外 / 有道智云
NETEASE_APP_KEY=
NETEASE_APP_SECRET=
